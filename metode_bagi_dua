import matplotlib.pyplot as plt
import numpy as np

def f(x):
    return x**2 - 4

a = 0
b = 3
epsilon = 0.0001
mu = 0.0001
delta = 0.0001
N = 100

if f(a) * f(b) > 0:
    print("Tidak ada akar!")

else:
    x_lama = None

    for i in range(1, N + 1):
        x = a + (b - a) / 2

        if x_lama is not None and x != 0:
            galat = abs((x - x_lama) / x)
        else:
            galat = float("inf")

        if (abs(b - a) < epsilon or
            abs(f(x)) < mu or
            galat < delta):
            break

        if f(a) * f(x) < 0:
            b = x
        else:
            a = x

        x_lama = x

    print("Akar hampiran =", x)
    print("Jumlah iterasi =", i)
    print("Nilai f(x) =", f(x))

    # Visualisasi grafik
    nilai_x = np.linspace(0, 3, 200)
    nilai_y = f(nilai_x)

    plt.plot(nilai_x, nilai_y, label="f(x) = x² - 4")
    plt.axhline(0, color="black", linewidth=0.8)
    plt.axvline(x, color="red", linestyle="--",
                label=f"Akar hampiran = {x:.4f}")

    plt.scatter(x, f(x), color="red", zorder=3)

    plt.title("Grafik Metode Bagi Dua")
    plt.xlabel("Nilai x")
    plt.ylabel("Nilai f(x)")
    plt.grid(True)
    plt.legend()
    plt.show()
